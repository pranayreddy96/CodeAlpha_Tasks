stocks = {
    "AAPL": 180.00,
    "TSLA": 700.00,
    "AMZN": 900.00,
    "GOOGL": 250.00,
    "MSFT": 300.00
}

total = 0

print("Welcome to the Stock Portfolio Calculator!")
print("Available stocks: " + ", ".join(stocks.keys()))  

stock_name = input("Enter the stock symbol you want to buy: ")
quantity = int(input("Enter the quantity you want to buy: "))

if stock_name in stocks:
    stock_price = stocks[stock_name]
    investment = stock_price * quantity
    total += investment
    print(f"You bought {quantity} shares of {stock_name} at ${stock_price:.2f} each. Total investment: ${investment:.2f}")
else:
    print("Sorry, that stock is not available.")

choice = input("Do you want to save result to a file? (yes/no): ")
if choice == "yes":
    with open("portfolio_results.txt", "w") as f:
        f.write(f"Total investment: ${total:.2f}")
    print("Results saved to portfolio_results.txt")
    f.close()
else:
    print("Results not saved.")